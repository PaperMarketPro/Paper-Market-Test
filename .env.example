# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Always-on Node Server: Railway / Render / Fly.io / Cloud Run / VPS)
# ==========================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://papermarket.vercel.app

# Upstox Developer API & V3 Market Data Feed Credentials
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://papermarket.vercel.app/api/integrations/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_TOTP_SECRET=
UPSTOX_MOBILE_NUMBER=
UPSTOX_PIN=

# Gemini AI Key
GEMINI_API_KEY=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin Configuration (Optional for backend Firestore sync)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel Deployment)
# ==========================================
# Point Vercel build to your persistent backend URL
VITE_BACKEND_URL=https://your-backend.up.railway.app
VITE_WS_URL=wss://your-backend.up.railway.app/api/ws

# Firebase Web Config (Injected automatically in AI Studio, required for Vercel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

